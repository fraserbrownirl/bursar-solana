    "@solana-program/token-2022": "^0.20.1",
    "@solana/kit": "^8.6.0",
    "@x402/core": "^2.30.0",
    "@x402/express": "^2.30.0",
    "@x402/svm": "^2.30.0",
    "bs58": "^6.0.0",
    "express": "^5.3.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
